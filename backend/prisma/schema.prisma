generator client {
  provider = "prisma-client-js"
}

datasource db {
   provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  roleId Int      @id @default(autoincrement()) @map("role_id") @db.SmallInt
  code   RoleCode @unique
  name   String   @db.VarChar(100)
  users  User[]

  @@map("roles")
}

model User {
    userId           BigInt           @id @default(autoincrement()) @map("user_id")
  roleId           Int              @map("role_id")
  email            String?          @unique @db.VarChar(150)
  passwordHash     String?          @map("password_hash") @db.VarChar(255)
  fullName         String           @map("full_name") @db.VarChar(150)
  phone            String?          @db.VarChar(20)
  avatarUrl        String?          @map("avatar_url")
  status           UserStatus       @default(Active)
  isDeleted        Boolean          @default(false) @map("is_deleted")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  dentist          Dentist?
  unlockedPatients Patient[]        @relation("PatientUnlockedBy")
  patient          Patient?         @relation("PatientAccount")
  paymentsHandled  Payment[]
  staffPermission  StaffPermission?
  systemLogs       SystemLog[]
  role             Role             @relation(fields: [roleId], references: [roleId])

  @@map("users")
}

model StaffPermission {
  userId    BigInt  @id @map("user_id")
    admission Boolean @default(false)
  clinical  Boolean @default(false)
  checkout  Boolean @default(false)
  settings  Boolean @default(false)
  user      User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("staff_permissions")
}

model Room {
  roomId         Int             @id @default(autoincrement()) @map("room_id")
  name           String          @unique @db.VarChar(50)
  isActive       Boolean         @default(true) @map("is_active")
  appointments   Appointment[]
  dentistShifts  DentistShift[]
  dentists       Dentist[]
  invoices       Invoice[]
  medicalRecords MedicalRecord[]
  queueTickets   QueueTicket[]

  @@map("rooms")
}

model Dentist {
   dentistId              BigInt                    @id @default(autoincrement()) @map("dentist_id")
  userId                 BigInt                    @unique @map("user_id")
  specialty              String?                   @db.VarChar(255)
  degree                 String?                   @db.VarChar(100)
  experienceYears        Int?                      @map("experience_years")
  casesHandled           String?                   @map("cases_handled") @db.VarChar(20)
  bio                    String?
  motto                  String?
  defaultRoomId          Int?                      @map("default_room_id")
  isActive               Boolean                   @default(true) @map("is_active")
  appointments           Appointment[]
  certifications         DentistCertification[]
  clinicalStrengths      DentistClinicalStrength[]
  education              DentistEducation[]
  shifts                 DentistShift[]
  workHistory            DentistWorkHistory[]
  defaultRoom            Room?                     @relation(fields: [defaultRoomId], references: [roomId])
  user                   User                      @relation(fields: [userId], references: [userId])
  invoices               Invoice[]
  medicalRecords         MedicalRecord[]
  queueTickets           QueueTicket[]
  shiftChangesAsNew      ShiftChangeNotification[] @relation("ShiftChangeNewDentist")
  shiftChangesAsOriginal ShiftChangeNotification[] @relation("ShiftChangeOriginalDentist")
  treatmentPlans         TreatmentPlan[]


  @@map("dentists")
}

model DentistEducation {
  id          BigInt  @id @default(autoincrement())
  dentistId   BigInt  @map("dentist_id")
  description String
  sortOrder   Int     @default(0) @map("sort_order")
  dentist     Dentist @relation(fields: [dentistId], references: [dentistId], onDelete: Cascade)

  @@map("dentist_education")
}

model DentistCertification {
  id          BigInt  @id @default(autoincrement())
  dentistId   BigInt  @map("dentist_id")
  description String
  sortOrder   Int     @default(0) @map("sort_order")
  dentist     Dentist @relation(fields: [dentistId], references: [dentistId], onDelete: Cascade)

  @@map("dentist_certifications")
}

model DentistClinicalStrength {
  id          BigInt  @id @default(autoincrement())
  dentistId   BigInt  @map("dentist_id")
  description String
  sortOrder   Int     @default(0) @map("sort_order")
  dentist     Dentist @relation(fields: [dentistId], references: [dentistId], onDelete: Cascade)

  @@map("dentist_clinical_strengths")
}

model DentistWorkHistory {
  id          BigInt  @id @default(autoincrement())
  dentistId   BigInt  @map("dentist_id")
  periodText  String? @map("period_text") @db.VarChar(100)
  description String
  sortOrder   Int     @default(0) @map("sort_order")
  dentist     Dentist @relation(fields: [dentistId], references: [dentistId], onDelete: Cascade)

  @@map("dentist_work_history")
}

model MembershipTier {
  tierId          Int       @id @default(autoincrement()) @map("tier_id")
  code            String    @unique @db.VarChar(20)
  name            String    @db.VarChar(50)
  minPoints       Int       @default(0) @map("min_points")
  discountPercent Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  patients        Patient[]

  @@map("membership_tiers")
}

model Patient {
  patientId          BigInt              @id @default(autoincrement()) @map("patient_id")
  userId             BigInt?             @unique @map("user_id")
  fullName           String              @map("full_name") @db.VarChar(150)
  phone              String              @unique @db.VarChar(20)
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  gender             String?             @db.VarChar(10)
  criticalAllergy    String?             @map("critical_allergy")
  medicalCondition   String?             @map("medical_condition")
  address            String?             @db.VarChar(255)
  walletBalance      Decimal             @default(0) @map("wallet_balance") @db.Decimal(14, 2)
  loyaltyPoints      Int                 @default(0) @map("loyalty_points")
  tierId             Int                 @map("tier_id")
  isLocked           Boolean             @default(false) @map("is_locked")
  lockedReason       String?             @map("locked_reason")
  unlockedByUserId   BigInt?             @map("unlocked_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  appointments       Appointment[]
  invoices           Invoice[]
  medicalRecords     MedicalRecord[]
  tier               MembershipTier      @relation(fields: [tierId], references: [tierId])
  unlockedBy         User?               @relation("PatientUnlockedBy", fields: [unlockedByUserId], references: [userId])
  user               User?               @relation("PatientAccount", fields: [userId], references: [userId])
  queueTickets       QueueTicket[]
  reviews            ServiceReview[]
  treatmentPlans     TreatmentPlan[]
  walletTransactions WalletTransaction[]

  @@map("patients")
}

model WalletTransaction {
  walletTxId       BigInt       @id @default(autoincrement()) @map("wallet_tx_id")
  patientId        BigInt       @map("patient_id")
  amount           Decimal      @db.Decimal(14, 2)
  type             WalletTxType
  relatedInvoiceId BigInt?      @map("related_invoice_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  patient          Patient      @relation(fields: [patientId], references: [patientId])
  relatedInvoice   Invoice?     @relation(fields: [relatedInvoiceId], references: [invoiceId])

  @@map("wallet_transactions")
}

model ServiceCategory {
  categoryId Int       @id @default(autoincrement()) @map("category_id")
  name       String    @unique @db.VarChar(100)
  services   Service[]

  @@map("service_categories")
}

model Service {
  serviceId             BigInt                 @id @default(autoincrement()) @map("service_id")
  categoryId            Int?                   @map("category_id")
  name                  String                 @db.VarChar(150)
  price                 Decimal                @db.Decimal(14, 2)
  durationMinutes       Int                    @map("duration_minutes")
  bufferMinutes         Int                    @default(0) @map("buffer_minutes")
  isActive              Boolean                @default(true) @map("is_active")
  description           String?
  imageUrl              String?                @map("image_url")
  appointments          Appointment[]
  invoiceItems          InvoiceItem[]
  medicalRecordServices MedicalRecordService[]
  queueTickets          QueueTicket[]
  reviews               ServiceReview[]
  category              ServiceCategory?       @relation(fields: [categoryId], references: [categoryId])

  @@map("services")
}

model ClinicOperatingHour {
  weekday    Int       @id @db.SmallInt
  openTime   DateTime  @map("open_time") @db.Time(6)
  closeTime  DateTime  @map("close_time") @db.Time(6)
  lunchStart DateTime? @map("lunch_start") @db.Time(6)
  lunchEnd   DateTime? @map("lunch_end") @db.Time(6)
  isClosed   Boolean   @default(false) @map("is_closed")

  @@map("clinic_operating_hours")
}

model DentistShift {
  shiftId       BigInt                    @id @default(autoincrement()) @map("shift_id")
  dentistId     BigInt                    @map("dentist_id")
  roomId        Int                       @map("room_id")
  workDate      DateTime                  @map("work_date") @db.Date
  shiftType     ShiftType                 @map("shift_type")
  startTime     DateTime                  @map("start_time") @db.Time(6)
  endTime       DateTime                  @map("end_time") @db.Time(6)
  isActive      Boolean                   @default(true) @map("is_active")
  dentist       Dentist                   @relation(fields: [dentistId], references: [dentistId])
  room          Room                      @relation(fields: [roomId], references: [roomId])
  notifications ShiftChangeNotification[]

  @@unique([dentistId, workDate, shiftType])
  @@map("dentist_shifts")
}

model Appointment {
  appointmentId       BigInt                    @id @default(autoincrement()) @map("appointment_id")
  patientId           BigInt                    @map("patient_id")
  dentistId           BigInt                    @map("dentist_id")
  serviceId           BigInt                    @map("service_id")
  roomId              Int?                      @map("room_id")
  startTime           DateTime                  @map("start_time")
  endTime             DateTime                  @map("end_time")
  status              AppointmentStatus         @default(Confirmed)
  bookingChannel      BookingChannel            @default(Online) @map("booking_channel")
  patientNotes        String?                   @map("patient_notes")
  otpVerified         Boolean                   @default(false) @map("otp_verified")
  createdAt           DateTime                  @default(now()) @map("created_at")
  cancelledAt         DateTime?                 @map("cancelled_at")
  cancelReason        String?                   @map("cancel_reason")
  dentist             Dentist                   @relation(fields: [dentistId], references: [dentistId])
  patient             Patient                   @relation(fields: [patientId], references: [patientId])
  room                Room?                     @relation(fields: [roomId], references: [roomId])
  service             Service                   @relation(fields: [serviceId], references: [serviceId])
  queueTicket         QueueTicket?
  serviceReview       ServiceReview?
  shiftChangeAffected ShiftChangeAffectedItem[]

  @@index([dentistId, startTime])
  @@index([patientId])
  @@map("appointments")
}

model QueueTicket {
  ticketId           BigInt         @id @default(autoincrement()) @map("ticket_id")
  appointmentId      BigInt?        @unique @map("appointment_id")
  patientId          BigInt         @map("patient_id")
  dentistId          BigInt         @map("dentist_id")
  roomId             Int?           @map("room_id")
  serviceId          BigInt?        @map("service_id")
  status             QueueStatus    @default(Waiting)
  checkInTime        DateTime       @default(now()) @map("check_in_time")
  startTreatmentTime DateTime?      @map("start_treatment_time")
  endTreatmentTime   DateTime?      @map("end_treatment_time")
  medicalRecord      MedicalRecord?
  appointment        Appointment?   @relation(fields: [appointmentId], references: [appointmentId])
  dentist            Dentist        @relation(fields: [dentistId], references: [dentistId])
  patient            Patient        @relation(fields: [patientId], references: [patientId])
  room               Room?          @relation(fields: [roomId], references: [roomId])
  service            Service?       @relation(fields: [serviceId], references: [serviceId])

  @@map("queue_tickets")
}

model TreatmentPlan {
  planId             BigInt          @id @default(autoincrement()) @map("plan_id")
  patientId          BigInt          @map("patient_id")
  dentistId          BigInt          @map("dentist_id")
  title              String          @db.VarChar(255)
  status             PlanStatus      @default(Active)
  estimatedTotalCost Decimal?        @map("estimated_total_cost") @db.Decimal(14, 2)
  createdAt          DateTime        @default(now()) @map("created_at")
  medicalRecords     MedicalRecord[]
  dentist            Dentist         @relation(fields: [dentistId], references: [dentistId])
  patient            Patient         @relation(fields: [patientId], references: [patientId])

  @@map("treatment_plans")
}

model MedicalRecord {
  recordId        BigInt                 @id @default(autoincrement()) @map("record_id")
  patientId       BigInt                 @map("patient_id")
  dentistId       BigInt                 @map("dentist_id")
  roomId          Int?                   @map("room_id")
  queueTicketId   BigInt?                @unique @map("queue_ticket_id")
  treatmentPlanId BigInt?                @map("treatment_plan_id")
  sessionType     SessionType            @default(independent) @map("session_type")
  visitDate       DateTime               @default(now()) @map("visit_date") @db.Date
  diagnosis       String?
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  invoice         Invoice?
  files           MedicalRecordFile[]
  services        MedicalRecordService[]
  teeth           MedicalRecordTooth[]
  dentist         Dentist                @relation(fields: [dentistId], references: [dentistId])
  patient         Patient                @relation(fields: [patientId], references: [patientId])
  queueTicket     QueueTicket?           @relation(fields: [queueTicketId], references: [ticketId])
  room            Room?                  @relation(fields: [roomId], references: [roomId])
  treatmentPlan   TreatmentPlan?         @relation(fields: [treatmentPlanId], references: [planId])
  prescription    Prescription?

  @@map("medical_records")
}

model MedicalRecordTooth {
  id            BigInt         @id @default(autoincrement())
  recordId      BigInt         @map("record_id")
  toothNumber   Int            @map("tooth_number")
  condition     ToothCondition
  treatmentNote String?        @map("treatment_note")
  record        MedicalRecord  @relation(fields: [recordId], references: [recordId], onDelete: Cascade)

  @@map("medical_record_teeth")
}

model MedicalRecordFile {
  fileId     BigInt        @id @default(autoincrement()) @map("file_id")
  recordId   BigInt        @map("record_id")
  fileType   FileType      @map("file_type")
  title      String        @db.VarChar(255)
  fileSizeKb Int?          @map("file_size_kb")
  url        String?
  record     MedicalRecord @relation(fields: [recordId], references: [recordId], onDelete: Cascade)

  @@map("medical_record_files")
}

model MedicalRecordService {
  recordId  BigInt        @map("record_id")
  serviceId BigInt        @map("service_id")
  record    MedicalRecord @relation(fields: [recordId], references: [recordId], onDelete: Cascade)
  service   Service       @relation(fields: [serviceId], references: [serviceId])

  @@id([recordId, serviceId])
  @@map("medical_record_services")
}

model Prescription {
  prescriptionId BigInt             @id @default(autoincrement()) @map("prescription_id")
  recordId       BigInt             @unique @map("record_id")
  instructions   String?
  items          PrescriptionItem[]
  record         MedicalRecord      @relation(fields: [recordId], references: [recordId], onDelete: Cascade)

  @@map("prescriptions")
}

model PrescriptionItem {
  itemId         BigInt       @id @default(autoincrement()) @map("item_id")
  prescriptionId BigInt       @map("prescription_id")
  medicineName   String       @map("medicine_name") @db.VarChar(150)
  dose           String?      @db.VarChar(100)
  duration       String?      @db.VarChar(100)
  note           String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [prescriptionId], onDelete: Cascade)

  @@map("prescription_items")
}

model Invoice {
  invoiceId          BigInt              @id @default(autoincrement()) @map("invoice_id")
  patientId          BigInt              @map("patient_id")
  medicalRecordId    BigInt?             @unique @map("medical_record_id")
  dentistId          BigInt?             @map("dentist_id")
  roomId             Int?                @map("room_id")
  totalPrice         Decimal             @default(0) @map("total_price") @db.Decimal(14, 2)
  insuranceDiscount  Decimal             @default(0) @map("insurance_discount") @db.Decimal(14, 2)
  memberDiscount     Decimal             @default(0) @map("member_discount") @db.Decimal(14, 2)
  netPrice           Decimal             @default(0) @map("net_price") @db.Decimal(14, 2)
  paidAmount         Decimal             @default(0) @map("paid_amount") @db.Decimal(14, 2)
  remainingAmount    Decimal             @default(0) @map("remaining_amount") @db.Decimal(14, 2)
  status             InvoiceStatus       @default(Pending)
  createdAt          DateTime            @default(now()) @map("created_at")
  items              InvoiceItem[]
  dentist            Dentist?            @relation(fields: [dentistId], references: [dentistId])
  medicalRecord      MedicalRecord?      @relation(fields: [medicalRecordId], references: [recordId])
  patient            Patient             @relation(fields: [patientId], references: [patientId])
  room               Room?               @relation(fields: [roomId], references: [roomId])
  payments           Payment[]
  walletTransactions WalletTransaction[]

  @@map("invoices")
}

model InvoiceItem {
  invoiceItemId BigInt  @id @default(autoincrement()) @map("invoice_item_id")
  invoiceId     BigInt  @map("invoice_id")
  serviceId     BigInt  @map("service_id")
  price         Decimal @db.Decimal(14, 2)
  quantity      Int     @default(1)
  invoice       Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  service       Service @relation(fields: [serviceId], references: [serviceId])

  @@map("invoice_items")
}

model Payment {
  paymentId     BigInt        @id @default(autoincrement()) @map("payment_id")
  invoiceId     BigInt        @map("invoice_id")
  cashierUserId BigInt?       @map("cashier_user_id")
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now()) @map("paid_at")
  cashierUser   User?         @relation(fields: [cashierUserId], references: [userId])
  invoice       Invoice       @relation(fields: [invoiceId], references: [invoiceId])

  @@map("payments")
}

model ShiftChangeNotification {
  notifId           BigInt                    @id @default(autoincrement()) @map("notif_id")
  shiftId           BigInt?                   @map("shift_id")
  shiftDate         DateTime                  @map("shift_date") @db.Date
  shiftType         String                    @map("shift_type") @db.VarChar(20)
  originalDentistId BigInt                    @map("original_dentist_id")
  newDentistId      BigInt                    @map("new_dentist_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  affectedItems     ShiftChangeAffectedItem[]
  newDentist        Dentist                   @relation("ShiftChangeNewDentist", fields: [newDentistId], references: [dentistId])
  originalDentist   Dentist                   @relation("ShiftChangeOriginalDentist", fields: [originalDentistId], references: [dentistId])
  shift             DentistShift?             @relation(fields: [shiftId], references: [shiftId])

  @@map("shift_change_notifications")
}

model ShiftChangeAffectedItem {
  id             BigInt                  @id @default(autoincrement())
  notifId        BigInt                  @map("notif_id")
  appointmentId  BigInt                  @map("appointment_id")
  resolved       Boolean                 @default(false)
  resolvedAction ResolvedAction?         @map("resolved_action")
  appointment    Appointment             @relation(fields: [appointmentId], references: [appointmentId])
  notification   ShiftChangeNotification @relation(fields: [notifId], references: [notifId], onDelete: Cascade)

  @@map("shift_change_affected_items")
}

model SystemLog {
  logId       BigInt    @id @default(autoincrement()) @map("log_id")
  module      LogModule
  logType     LogType   @map("log_type")
  message     String
  actorUserId BigInt?   @map("actor_user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  actorUser   User?     @relation(fields: [actorUserId], references: [userId])

  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}

model ServiceReview {
  reviewId      BigInt          @id @default(autoincrement()) @map("review_id")
  patientId     BigInt          @map("patient_id")
  appointmentId BigInt?         @unique @map("appointment_id")
  serviceId     BigInt?         @map("service_id")
  rating        Int             @db.SmallInt
  comment       String
  sentiment     ReviewSentiment @default(NEUTRAL)
  aiReply       String?         @map("ai_reply")
  aiRepliedAt   DateTime?       @map("ai_replied_at")
  status        ReviewStatus    @default(Approved)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  appointment   Appointment?    @relation(fields: [appointmentId], references: [appointmentId])
  patient       Patient         @relation(fields: [patientId], references: [patientId])
  service       Service?        @relation(fields: [serviceId], references: [serviceId])

  @@index([patientId])
  @@index([serviceId])
  @@map("service_reviews")
}

enum RoleCode {
  patient
  receptionist
  dentist
  cashier
  manager
}

enum UserStatus {
  Active
  Inactive
}

enum WalletTxType {
  Recharge
  PaymentDeduct
  Refund
}

enum ShiftType {
  Morning
  Afternoon
  Full
}

enum AppointmentStatus {
  Confirmed
  InProgress @map("In-Progress")
  Completed
  Cancelled
  NoShow
}

enum BookingChannel {
  Online
  Phone
  WalkIn @map("Walk-in")
  Staff
}

enum QueueStatus {
  Waiting
  InChair   @map("In Chair")
  Completed
}

enum PlanStatus {
  Active
  Completed
  Cancelled
}

enum SessionType {
  independent
  planInit    @map("plan_init")
  planSession @map("plan_session")
}

enum ToothCondition {
  healthy
  decay
  missing
  crown
  bridge
  treated
  implant
}

enum FileType {
  pdf
  image
  prescription
}

enum InvoiceStatus {
  Pending
  PartiallyPaid @map("Partially Paid")
  Paid
}

enum PaymentMethod {
  Cash
  Card
  Transfer
  Wallet
}

enum ResolvedAction {
  updated
  cancelled
}

enum LogModule {
  RECEPTION
  DENTIST
  CASHIER
  SYSTEM
  AUTH
}

enum LogType {
  INFO
  SUCCESS
  WARN
  ERR
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ReviewStatus {
  Pending
  Approved
  Hidden
}

