# Server Port
PORT=5000

# Database Configuration (PostgreSQL)
# Sử dụng localhost khi chạy app bằng npm run dev ngoài máy host:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodsmile_clinic?schema=public"
# Sử dụng service name khi chạy app trực tiếp trong Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@goodsmile-db:5432/goodsmile_clinic?schema=public"

# Redis Configuration
# Sử dụng localhost khi chạy app ngoài máy host:
REDIS_URL="redis://localhost:6379"
# Sử dụng service name khi chạy trong Docker:
# REDIS_URL="redis://goodsmile-cache:6379"

# JWT Secret Key
JWT_SECRET="supersecretjwtkey123!"
